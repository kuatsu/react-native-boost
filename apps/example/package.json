{
  "name": "react-native-boost-example",
  "version": "0.0.1",
  "main": "index.ts",
  "scripts": {
    "gen:unoptimized": "node scripts/gen-unoptimized.mjs",
    "prestart": "node scripts/gen-unoptimized.mjs",
    "predev": "node scripts/gen-unoptimized.mjs",
    "preandroid": "node scripts/gen-unoptimized.mjs",
    "preios": "node scripts/gen-unoptimized.mjs",
    "preweb": "node scripts/gen-unoptimized.mjs",
    "pretypecheck": "pnpm --filter react-native-boost build && node scripts/gen-unoptimized.mjs",
    "typecheck": "tsc --noEmit",
    "start": "expo start",
    "dev": "expo start",
    "android": "rm -rf android && expo run:android",
    "ios": "rm -rf ios && expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-community/slider": "5.2.1",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "^57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-boost": "workspace:*",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-time-to-render": "workspace:*",
    "react-native-unistyles": "3.3.0",
    "react-native-web": "~0.21.0",
    "uniwind": "1.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.18",
    "typescript": "~7.0.2"
  },
  "private": true
}
