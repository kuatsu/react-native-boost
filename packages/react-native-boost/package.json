{
  "name": "react-native-boost",
  "description": "🚀 Boost your React Native app's performance with a single line of code",
  "version": "1.7.0",
  "exports": {
    "./package.json": "./package.json",
    "./runtime": {
      "import": {
        "types": "./dist/runtime/index.d.ts",
        "default": "./dist/runtime/esm/index.mjs"
      },
      "default": "./dist/runtime/index.js"
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin/index.d.ts",
        "default": "./dist/plugin/esm/index.mjs"
      },
      "default": "./dist/plugin/index.js"
    },
    "./metro": {
      "types": "./dist/metro/index.d.ts",
      "default": "./dist/metro/index.js"
    },
    "./uniwind": {
      "types": "./dist/runtime/uniwind.d.ts",
      "default": "./dist/runtime/uniwind.js"
    }
  },
  "typesVersions": {
    "*": {
      "runtime": [
        "dist/runtime/index.d.ts"
      ],
      "plugin": [
        "dist/plugin/index.d.ts"
      ],
      "metro": [
        "dist/metro/index.d.ts"
      ]
    }
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "performance",
    "optimization",
    "bundle",
    "optimize"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && rollup -c",
    "build:watch": "rollup -c -w",
    "dev": "pnpm build:watch",
    "pretest": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "release-it",
    "prepack": "cp ../../README.md ./README.md",
    "postpack": "rm ./README.md"
  },
  "files": [
    "src",
    "dist",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuatsu/react-native-boost.git"
  },
  "author": "Kuatsu App Agency <hello@kuatsu.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kuatsu/react-native-boost/issues"
  },
  "homepage": "https://github.com/kuatsu/react-native-boost#readme",
  "packageManager": "pnpm@12.3.1",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/helper-module-imports": "^7.29.7",
    "@babel/helper-plugin-utils": "^7.29.7",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@babel/plugin-syntax-jsx": "^7.29.7",
    "@babel/plugin-syntax-typescript": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@react-native/babel-preset": "0.87.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/babel__core": "^7.20.5",
    "@types/babel__helper-module-imports": "^7.18.3",
    "@types/babel__helper-plugin-utils": "^7.10.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript/typescript6": "^6.0.2",
    "babel-plugin-tester": "^12.0.0",
    "fast-check": "^4.9.0",
    "metro": "0.87.0",
    "metro-config": "0.87.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.1",
    "react-test-renderer": "19.2.8",
    "release-it": "^21.0.2",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "~7.0.2",
    "uniwind": "1.12.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.83.0"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true,
      "versionArgs": [
        "--workspaces-update=false"
      ]
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "infile": "CHANGELOG.md"
      }
    }
  }
}
